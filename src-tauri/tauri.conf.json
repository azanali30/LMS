{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstitutoPropio",
  "version": "1.0.0",
  "identifier": "com.institutopropio.desktop",
  "build": {
    "frontendDist": "../desktop",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "InstitutoPropio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "InstitutoPropio",
    "copyright": "Copyright 2026 InstitutoPropio. All rights reserved.",
    "shortDescription": "InstitutoPropio Educational Campus Platform",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
